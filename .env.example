AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
AI_MODEL=openai/gpt-4o-mini
AI_BASE_URL=https://openrouter.ai/api/v1

# Alternative OpenAI-compatible config:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://your-openai-compatible-base-url/v1
# LAB_MODEL=qwen-plus-2025-04-28
#
# Or:
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# Alternative RapidAPI config:
# AI_PROVIDER=rapidapi
# RAPIDAPI_KEY=your-rapidapi-key
# RAPIDAPI_AI_HOST=your-chat-api-host.p.rapidapi.com
# RAPIDAPI_AI_URL=https://your-chat-api-host.p.rapidapi.com/path/to/chat-endpoint
# AI_MODEL=gpt-4o-mini

# Optional chatbot tool: web_search_tool
# Keep AI_PROVIDER=openai/openrouter if you only want RapidAPI for web search.
# RAPIDAPI_KEY=your-rapidapi-key
# RAPIDAPI_WEB_HOST=your-web-search-api-host.p.rapidapi.com
# RAPIDAPI_WEB_URL=https://your-web-search-api-host.p.rapidapi.com/search
# RAPIDAPI_WEB_METHOD=GET
# RAPIDAPI_WEB_QUERY_PARAM=q
